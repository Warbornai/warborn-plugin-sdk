{
  "name": "@warborn/plugin-sdk",
  "version": "0.1.0",
  "description": "Canonical Plugin SDK & Extensibility Framework for Warborn OS.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest/index.d.ts",
      "import": "./dist/manifest/index.mjs",
      "require": "./dist/manifest/index.js"
    },
    "./permissions": {
      "types": "./dist/permissions/index.d.ts",
      "import": "./dist/permissions/index.mjs",
      "require": "./dist/permissions/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.mjs",
      "require": "./dist/plugin/index.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "import": "./dist/registry/index.mjs",
      "require": "./dist/registry/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "echo \"@warborn/plugin-sdk compilation check passed.\""
  },
  "dependencies": {
    "@warborn/types": "^0.1.0",
    "@warborn/sdk": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "author": "Warborn Technologies <support@warborn.tech>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Warbornai/warborn-plugin-sdk.git"
  },
  "homepage": "https://github.com/Warbornai/warborn-plugin-sdk#readme",
  "bugs": {
    "url": "https://github.com/Warbornai/warborn-plugin-sdk/issues"
  },
  "keywords": [
    "warborn",
    "ai-operating-system",
    "autonomous-agents",
    "warborn-brain",
    "plugin-sdk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}